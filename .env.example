# Kakao REST API key. Server-side only; used for final Korean coord2address conversion.
KAKAO_REST_API_KEY=
# Kakao Map Web JavaScript key. Public browser key; register the Glomart JavaScript SDK domain in Kakao Developers.
KAKAO_MAP_JAVASCRIPT_KEY=
